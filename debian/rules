#!/usr/bin/make -f
# -*- makefile -*-

include /usr/share/dpkg/architecture.mk

export DH_VERBOSE=1
export CARGO_HOME=$(CURDIR)/target/cargo
export RUSTUP_TOOLCHAIN=stable
export PATH:=$(HOME)/.cargo/bin:$(PATH)

%:
	dh $@

override_dh_auto_clean:
	# Do not erase the cargo cache: preserves incremental compilation.
	# In CI, the target directory is absent anyway (clean clone).
	true

override_dh_auto_build:
	cargo build --release --workspace --verbose

override_dh_auto_test:
	# Every test in this workspace is either fixture-based (scraper, feed)
	# or mocked (wiremock, for anything that would otherwise hit
	# megatokyo.com/DeepL) — see core/src/*.rs's test modules — so this is
	# safe to run in a network-less build environment (Launchpad PPA
	# builders included).
	cargo test --release --workspace --verbose

override_dh_auto_install:
	mkdir -p $(CURDIR)/debian/tmp/usr/bin
	cp $(CURDIR)/target/release/megatokyo-daemon $(CURDIR)/debian/tmp/usr/bin/
	cp $(CURDIR)/target/release/megatokyo-gui $(CURDIR)/debian/tmp/usr/bin/

	mkdir -p $(CURDIR)/debian/tmp/usr/lib/systemd/user
	cp $(CURDIR)/debian/megatokyo-daemon.user.service $(CURDIR)/debian/tmp/usr/lib/systemd/user/megatokyo-daemon.service

override_dh_install:
	dh_install
	# QML sources: find_qml_path()'s primary candidate in gui/src/launcher.rs.
	mkdir -p $(CURDIR)/debian/megatokyo-gui/usr/share/megatokyo
	cp -r $(CURDIR)/qml $(CURDIR)/debian/megatokyo-gui/usr/share/megatokyo/
	# App icon (raster, not vector — see qml/icons/app-icon.png's own
	# note) with the correct filename (dh_install can't rename), in a
	# fixed-size hicolor directory rather than scalable/, which the
	# icon theme spec reserves for actual vector artwork.
	mkdir -p $(CURDIR)/debian/megatokyo-gui/usr/share/icons/hicolor/512x512/apps
	cp $(CURDIR)/qml/icons/app-icon.png $(CURDIR)/debian/megatokyo-gui/usr/share/icons/hicolor/512x512/apps/megatokyo.png

override_dh_missing:
	dh_missing --list-missing

.PHONY: override_dh_auto_build override_dh_auto_test override_dh_auto_install override_dh_install
